    {
      "id": "metadata-stripper",
      "version": "1.0.1",
      "name": {
        "en": "Metadata stripper",
        "pl": "Usuwanie metadanych",
        "de": "Metadaten entfernen",
        "fr": "Suppression des métadonnées",
        "es": "Eliminar metadatos",
        "it": "Rimozione metadati",
        "pt-BR": "Remoção de metadados",
        "uk": "Видалення метаданих"
      },
      "summary": {
        "en": "GPS location, camera, dates, author, comments and thumbnails are removed. The original stays as it is; the clean copy gets -clean in its name.",
        "pl": "Usuwa lokalizację GPS, dane aparatu, daty, autora, komentarze i miniatury. Oryginał zostaje bez zmian, a czysta kopia dostaje -clean w nazwie.",
        "de": "Entfernt GPS-Standort, Kameradaten, Datumsangaben, Autor, Kommentare und Vorschaubilder. Das Original bleibt unverändert, die saubere Kopie bekommt -clean im Namen.",
        "fr": "Supprime la position GPS, les données de l'appareil, les dates, l'auteur, les commentaires et les miniatures. L'original reste intact ; la copie propre reçoit -clean dans son nom.",
        "es": "Elimina la ubicación GPS, los datos de la cámara, las fechas, el autor, los comentarios y las miniaturas. El original no cambia; la copia limpia lleva -clean en el nombre.",
        "it": "Rimuove posizione GPS, dati della fotocamera, date, autore, commenti e miniature. L'originale resta com'è; la copia pulita ha -clean nel nome.",
        "pt-BR": "Remove localização GPS, dados da câmera, datas, autor, comentários e miniaturas. O original fica como está; a cópia limpa recebe -clean no nome.",
        "uk": "Видаляє GPS-розташування, дані камери, дати, автора, коментарі й мініатюри. Оригінал лишається без змін, а чиста копія отримує -clean у назві."
      },
      "author": "WindowCraft Dev Team",
      "license": "MIT",
      "min_app": "1.5.0",
      "homepage": "https://github.com/windowcraftdev/WindowCraftExtensions/tree/main/extensions/metadata-stripper",
