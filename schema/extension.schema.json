{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WindowCraft extension manifest",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "downloads": [
      "entry"
    ]
  },
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "summary",
    "author",
    "license"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "min_app": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://github\\.com/\\S*$"
    },
    "entry": {
      "type": "string",
      "pattern": "^[^/\\\\]*\\.exe(?![\\s\\S])",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "downloads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x64": {
          "$ref": "#/$defs/download"
        },
        "arm64": {
          "$ref": "#/$defs/download"
        }
      },
      "minProperties": 1
    }
  },
  "$defs": {
