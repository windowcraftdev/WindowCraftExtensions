        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/windowcraftdev/WindowCraftExtensions/releases/download/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
