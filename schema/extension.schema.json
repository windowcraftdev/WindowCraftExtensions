      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^\\s*\\S(?:[\\s\\S]{0,46}\\S)?\\s*(?![\\s\\S])"
            },
            {
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
              }
            }
          ]
        },
        "pl": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^\\s*\\S(?:[\\s\\S]{0,46}\\S)?\\s*(?![\\s\\S])"
            },
            {
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
              }
            }
          ]
        },
        "de": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^\\s*\\S(?:[\\s\\S]{0,46}\\S)?\\s*(?![\\s\\S])"
            },
